# RunPod Serverless Deployment Configuration
# Deploy to: https://www.runpod.io/console/serverless

{
  "name": "structural-ai-gpu",
  "description": "Structural AI API - Chomskyan Syntactic Analysis with GPU acceleration",
  "version": "1.0.0",
  "runtime": "vllm",
  "gpu": {
    "type": "NVIDIA",
    "minVram": 6,
    "recommended": "RTX 3050 or better"
  },
  "handler": "src.pipeline:StructuralAIPipeline",
  "environment": {
    "WHISPER_MODEL": "base",
    "WHISPER_DEVICE": "cuda",
    "WHISPER_COMPUTE_TYPE": "float16",
    "SPACY_MODEL": "en_core_web_lg",
    "API_HOST": "0.0.0.0",
    "API_PORT": "5000"
  },
  "requirements": [
    "faster-whisper>=1.0.0",
    "spacy>=3.7.0",
    "nltk>=3.8.0",
    "torch>=2.0.0",
    "flask>=3.0.0"
  ],
  "scaling": {
    "minInstances": 0,
    "maxInstances": 10,
    "idleTimeout": 300
  },
  "pricing": {
    "billingMode": "per_second",
    "gpuPricePerHour": 0.45
  }
}
